# Neon Postgres (auto-wired by the Vercel Neon integration; pull with `vercel env pull`)
DATABASE_URL=

# EAS (Base Sepolia for PoC)
PUBLIC_EAS_CHAIN_ID=84532
PUBLIC_EAS_CONTRACT=0x4200000000000000000000000000000000000021
PUBLIC_EAS_SCHEMA_UID=
# easscan GraphQL endpoint for the active chain
PUBLIC_EASSCAN_GRAPHQL=https://base-sepolia.easscan.org/graphql
# RPC for EAS reads/issuer signing and (separately) mainnet ENS reverse lookups
EAS_RPC_URL=https://sepolia.base.org
ETH_RPC_URL=https://eth.llamarpc.com

# HMAC secret for signed identity cookies (generate a random 32+ byte value)
AUTH_SECRET=

# Issuer key for the Twitter trusted-issuer attestation path (keep in a KMS/HSM in prod)
EAS_ISSUER_PRIVATE_KEY=

# Twitter / X OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
PUBLIC_TWITTER_REDIRECT_URI=https://legit.build/auth/twitter/callback

# Neynar (Farcaster identity + social graph for reputation)
NEYNAR_API_KEY=

# Forge tokens for the release poller (higher rate limits; optional)
GITHUB_TOKEN=
GITLAB_TOKEN=

# Secret guarding the cron endpoint (Vercel sends this as a bearer token)
CRON_SECRET=

# Public base URL
PUBLIC_BASE_URL=https://legit.build
